# Each header tree has its own compilation database, because the repository
# has several with the SAME names and different contents —
# `tools/cgen/gen/keel/keel_buffer_i32.type.h` is not the one in
# `golden/c23/keel/`, and neither is the one in `tools/transform/gen/`.
# clangd finds the right one walking up from the open file:
# `golden/compile_commands.json` for the suite, the root one for the rest.
#
# Do NOT pin `CompilationDatabase:` here. Pinning makes one of the trees apply
# to the whole repository, and the others silently get wrong flags.
#
# Generate/update:  ./gen-ccjson.sh

# The IncludeCleaner is wrong in this project BY CONSTRUCTION. It flags the
# prelude `keel.type.h` as "not used directly" in every generated header,
# because what the header uses — `bool`, `size_t` — it attributes to the
# headers the prelude includes, not to the prelude. But the prelude is
# NORMATIVE at the top of every module `.type.h` (backend §4.2): following
# the advice would break the shape the cases exist to pin down.
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
