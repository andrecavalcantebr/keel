{
  "name": "keel",
  "displayName": "keel",
  "description": "Syntax highlighting for keel — inherits the C grammar and adds the words of spec §2.2.",
  "version": "0.0.1",
  "publisher": "andrecavalcante",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "keel",
        "aliases": [
          "keel"
        ],
        "extensions": [
          ".k"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "keel",
        "scopeName": "source.keel",
        "path": "./syntaxes/keel.tmLanguage.json"
      },
      {
        "scopeName": "keel.injection",
        "path": "./syntaxes/keel-injection.tmLanguage.json",
        "injectTo": [
          "source.keel"
        ]
      }
    ]
  }
}
