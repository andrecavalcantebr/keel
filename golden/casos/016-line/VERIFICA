#!/usr/bin/env sh
# O caso 016 NÃO compila de propósito. Ele afirma o §6 — o mapeamento de linha —
# e o princípio 3: o erro do compilador C aparece na posição do FONTE KEEL, com
# os nomes que o usuário escreveu.
#
# As posições esperadas saem do próprio caso.k, das linhas marcadas /* ERRO */.
# Não há número escrito aqui: se o esperado.c mover um `#line`, o teste acusa.
#
#   $1 = compilador   $2 = -std=...   $3 = diretório do perfil
set -eu
dir=$(dirname "$0")

esperado=$(grep -n '/\* ERRO \*/' "$dir/caso.k" | cut -d: -f1 | tr '\n' ' ')
saida=$("$1" "$2" -I"$3" -I"$dir/esperado/$3" -c "$dir/esperado/$3/app/ml.c" -o /dev/null 2>&1 || true)
obtido=$(printf '%s\n' "$saida" | grep -oE 'app/ml\.k:[0-9]+' | cut -d: -f2 | tr '\n' ' ')

falhou=0
[ "$esperado" = "$obtido" ] || {
    echo "  posições: esperado [$esperado]  obtido [$obtido]"; falhou=1; }
printf '%s\n' "$saida" | grep -q 'f32 \*' || { echo "  falta a grafia keel f32 *"; falhou=1; }
printf '%s\n' "$saida" | grep -q 'i32 \*' || { echo "  falta a grafia keel i32 *"; falhou=1; }
printf '%s\n' "$saida" | grep -q 'ml\.c' && { echo "  o nome do gerado vazou"; falhou=1; }

[ $falhou -eq 0 ] || { printf '%s\n' "$saida" | sed 's/^/    /' | head -4; exit 1; }
exit 0
