# O único C do projeto é o de golden/, e o banco de compilação vive lá.
# Sem isto, o clangd só o encontra subindo a partir de um arquivo já dentro de
# golden/ — com isto, encontra a partir de qualquer lugar do repositório.
#
# Gerar/atualizar:  ./golden/gerar-ccjson.sh
CompileFlags:
  CompilationDatabase: golden

# O IncludeCleaner está errado neste projeto POR CONSTRUÇÃO. Ele marca
# `keel/prelude.h` como "não usado diretamente" em todo `.h` gerado, porque o
# que o cabeçalho usa — `bool`, `size_t` — ele atribui aos headers que o
# prelúdio inclui, e não ao prelúdio. Só que o prelúdio é NORMATIVO no topo de
# todo `.h` de módulo (backend §4.2): seguir o conselho quebraria a forma que
# os casos existem para fixar.
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
